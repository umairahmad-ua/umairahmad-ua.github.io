---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import PostStream from "@/components/PostStream.astro";
import Newsletter from "@/components/Newsletter.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const url = (p: string) => getRelativeLocaleUrl(locale, p);
const posts = getSortedPosts(await getCollection("posts"));
const recent = posts.slice(0, 24);
const homePath = url("");
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" data-home-path={homePath} class="app-layout my-1">
    <section id="intro" class="flex items-start gap-5 pt-8 pb-8">
      <img src="/avatar.png" alt="Umair Ahmad" width="72" height="72" class="size-16 shrink-0 rounded-full sm:size-[72px]" />
      <div class="text-[1.05rem] leading-relaxed">
        <p>Hi, I'm Umair. I build AI agents for companies that have to trust them, and I write about it here.</p>
        <p class="text-muted-foreground mt-2">A short <a class="text-accent underline decoration-dashed underline-offset-4" href={url("notes")}>note every Sunday</a> on what changed in AI that week, and a longer <a class="text-accent underline decoration-dashed underline-offset-4" href={url("articles")}>essay most Wednesdays</a> on something I built or broke. Every claim has a dated source. New here? <a class="text-accent underline decoration-dashed underline-offset-4" href={url("start-here")}>Start here</a>.</p>
        <div class="mt-3 flex items-center gap-1"><Socials /></div>
      </div>
    </section>

    <PostStream posts={recent} />

    <p class="mt-8"><a class="text-accent font-medium decoration-dashed underline-offset-4 hover:underline" href={url("archives")}>All posts, by month →</a></p>

    <Newsletter />
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
  });
</script>
