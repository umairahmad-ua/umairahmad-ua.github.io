---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import PostStream from "@/components/PostStream.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { isArticle } from "@/utils/byKind";
import config from "@/config";
const posts = getSortedPosts(await getCollection("posts")).filter(isArticle);
---
<Layout title={`Deep dives | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main pageTitle="Deep dives" pageDesc="Longer pieces on one system, one pattern or one mistake at a time. Most Wednesdays.">
    <PostStream {posts} showExcerpt />
  </Main>
  <Footer />
</Layout>
