---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { slugifyStr } from "@/utils/slugify";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
  showKind?: boolean;
  layout?: "list" | "row" | "tile";
  highlight?: boolean;
} & CollectionEntry<"posts">;

const {
  variant: Heading = "h2",
  showKind = true,
  layout = "list",
  highlight = false,
  id,
  data,
  filePath,
} = Astro.props;

const { title, description, kind, week, tags, ...props } = data;
const badge = kind === "note" ? (week ? `Week ${week}` : "Note") : "Article";
const href = getPostUrl(id, filePath, Astro.currentLocale);
const shownTags = tags.filter(t => t !== "weekly").slice(0, 3);
const cleanTitle = kind === "note" ? title.replace(/^Week \d+\/\d+:\s*/, "") : title;
---

<li class:list={[
  layout === "list" && "my-6",
  layout === "row" && ["card card-hover", highlight && "border-accent/60 ring-accent/15 ring-2"],
  layout === "tile" && "card card-hover flex flex-col",
]}>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
    {showKind && (
      <span class:list={["pill", kind === "note" ? "bg-accent-2/12 text-accent-2" : "bg-accent/12 text-accent"]}>
        {badge}
      </span>
    )}
    {highlight && <span class="pill bg-accent text-accent-foreground">Latest</span>}
    <Datetime {...props} />
  </div>
  <a href={href} class:list={["mt-1.5 inline-block font-heading font-semibold decoration-dashed underline-offset-4 hover:underline", layout === "tile" ? "text-xl" : "text-lg", "text-accent"]}>
    <Heading transition:name={toTransitionName(id)}>{cleanTitle}</Heading>
  </a>
  <p class:list={["mt-1.5", layout === "tile" && "text-muted-foreground grow"]}>{description}</p>
  {shownTags.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-1.5">
      {shownTags.map(t => (
        <li><a href={`/tags/${slugifyStr(t)}/`} class="bg-muted text-muted-foreground hover:text-accent rounded-md px-2 py-0.5 text-xs">#{t}</a></li>
      ))}
    </ul>
  )}
</li>
