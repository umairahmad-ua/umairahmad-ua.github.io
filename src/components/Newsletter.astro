---
import { extras } from "@/site.extras";
const { newsletter } = extras;
---

{
  newsletter.enabled && newsletter.username && (
    <section
      id="newsletter"
      class="border-border my-8 rounded-md border border-dashed p-5"
    >
      <h2 class="text-lg font-semibold">Get the weekly note by email</h2>
      <p class="text-muted-foreground mt-1 text-sm">
        One short note a week on building agents for real companies. No
        marketing, unsubscribe any time.
      </p>
      <form
        action={`https://buttondown.com/api/emails/embed-subscribe/${newsletter.username}`}
        method="post"
        target="popupwindow"
        class="mt-3 flex flex-col gap-2 sm:flex-row"
      >
        <label class="sr-only" for="bd-email">Email</label>
        <input
          type="email"
          name="email"
          id="bd-email"
          required
          placeholder="you@example.com"
          class="border-border bg-background focus:border-accent w-full rounded-sm border px-3 py-2 text-sm outline-none"
        />
        <button
          type="submit"
          class="bg-accent text-accent-foreground rounded-sm px-4 py-2 text-sm font-medium"
        >
          Subscribe
        </button>
      </form>
    </section>
  )
}
