---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";

type Props = { post: CollectionEntry<"posts">; showYear?: boolean; showExcerpt?: boolean };
const { post, showYear = false, showExcerpt = false } = Astro.props;
const { title, description, kind, week, tags, pubDatetime } = post.data;
const d = pubDatetime;
const date = d.toLocaleDateString("en-US", { month: "short", day: "2-digit", ...(showYear ? { year: "numeric" } : {}), timeZone: "UTC" });
const cleanTitle = kind === "note" ? title.replace(/^Week \d+\/\d+:\s*/, "") : title;
---

<li class="entry">
  <time class="entry-date" datetime={d.toISOString()}>{date}</time>
  <div class="min-w-0">
    <a href={getPostUrl(post.id, post.filePath, Astro.currentLocale)} class="hover:text-accent font-medium decoration-dashed underline-offset-4 hover:underline">
      <span transition:name={toTransitionName(post.id)}>{cleanTitle}</span>
    </a>
    <span class="text-muted-foreground ms-2 text-xs">{kind === "note" ? "weekly note" : "essay"}</span>
    {showExcerpt && <p class="text-muted-foreground mt-0.5 text-sm">{description}</p>}
  </div>
</li>
