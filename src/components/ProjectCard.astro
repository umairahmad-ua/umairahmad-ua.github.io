---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

type Props = { project: CollectionEntry<"projects">; compact?: boolean };
const { project, compact = false } = Astro.props;
const { title, summary, org, stack, url, repo } = project.data;
const { Content } = await render(project);
---

<li class="card card-hover">
  <h3 class="font-heading text-lg font-semibold">{title}</h3>
  <p class="text-muted-foreground mt-0.5 text-sm">{org}</p>
  <p class="mt-2">{summary}</p>
  {
    !compact && (
      <div class="app-prose mt-3 text-sm">
        <Content />
      </div>
    )
  }
  {
    stack.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {stack.map(s => (
          <li class="bg-muted text-muted-foreground rounded-md px-2 py-0.5 text-xs">{s}</li>
        ))}
      </ul>
    )
  }
  {
    (url || repo) && (
      <p class="mt-3 flex gap-4 text-sm">
        {url && (
          <a class="text-accent underline decoration-dashed underline-offset-4" href={url} target="_blank" rel="noopener noreferrer">
            Website
          </a>
        )}
        {repo && (
          <a class="text-accent underline decoration-dashed underline-offset-4" href={repo} target="_blank" rel="noopener noreferrer">
            Code
          </a>
        )}
      </p>
    )
  }
</li>
